# ─── Agent ─────────────────────────────────────────────────────────────────────
# Your agent's HTTP endpoint. The bridge POSTs
#   {"sender_id", "message_type": "voice|text", "content", "channel": "meta|twilio"}
# and expects {"reply_text": "..."} back. An empty reply_text sends nothing.
AGENT_WEBHOOK_URL=http://host.docker.internal:9000/agent
# Optional. Sent as "Authorization: Bearer <token>" to your agent.
AGENT_AUTH_TOKEN=
# Per-attempt timeout. Keep below a few minutes; users are waiting on WhatsApp.
AGENT_TIMEOUT_SECONDS=30
# Retries on connection errors and HTTP 429/502/503/504 only (exponential backoff).
AGENT_MAX_RETRIES=2

# ─── Public URL ────────────────────────────────────────────────────────────────
# The HTTPS address Meta/Twilio use to reach this service (e.g. your ngrok URL).
# Voice replies are served from <PUBLIC_BASE_URL>/static/audio/<random>.ogg,
# and Twilio signatures are checked against this URL.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ─── Meta WhatsApp Cloud API ───────────────────────────────────────────────────
# Leave META_ACCESS_TOKEN empty to disable the Meta channel.
# System-user or temporary access token from the Meta App Dashboard → WhatsApp → API Setup.
META_ACCESS_TOKEN=
# Any random string; paste the same value in the dashboard's webhook "Verify token".
META_VERIFY_TOKEN=
# App Dashboard → App settings → Basic → App secret. Used to check X-Hub-Signature-256.
META_APP_SECRET=
META_GRAPH_API_VERSION=v23.0

# ─── Twilio ────────────────────────────────────────────────────────────────────
# Leave TWILIO_ACCOUNT_SID empty to disable the Twilio channel.
TWILIO_ACCOUNT_SID=
# Used to check X-Twilio-Signature, download media and send replies.
TWILIO_AUTH_TOKEN=

# ─── Speech-to-text ────────────────────────────────────────────────────────────
# openai | azure | deepgram
STT_PROVIDER=openai
# Optional ISO-639-1 code (e.g. en, tr). Empty = auto-detect.
STT_LANGUAGE=
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# ─── Azure OpenAI (used when STT_PROVIDER=azure and/or TTS_PROVIDER=azure) ─────
# Resource endpoint, e.g. https://my-resource.openai.azure.com/
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-03-01-preview
# Deployment names in your resource (whisper / gpt-4o-mini-transcribe, gpt-4o-mini-tts).
AZURE_OPENAI_STT_DEPLOYMENT=whisper
AZURE_OPENAI_TTS_DEPLOYMENT=gpt-4o-mini-tts

# ─── Text-to-speech ────────────────────────────────────────────────────────────
# openai | azure (Ogg/Opus → WhatsApp voice note) | elevenlabs (MP3 → audio attachment)
TTS_PROVIDER=openai
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ─── Runtime ───────────────────────────────────────────────────────────────────
# Where generated audio is written; files older than AUDIO_TTL_SECONDS are deleted.
AUDIO_DIR=data/audio
AUDIO_TTL_SECONDS=3600
# Optional text sent when transcription or the agent fails. Empty = stay silent.
FALLBACK_REPLY_TEXT=
LOG_LEVEL=INFO
